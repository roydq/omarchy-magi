def load_colors():
    colors = dict(DEFAULT_COLORS)
    try:
        for line in THEME_COLORS.read_text().splitlines():
            key, sep, value = line.partition("=")
            value = value.strip().strip('"')
            if sep and value.startswith("#") and len(value) == 7:
                colors[key.strip()] = value
    except OSError:
        pass
    return colors


def mix(a, b, amount):
    """Blend hex color a toward b by amount (0..1)."""
    ca = [int(a[i : i + 2], 16) for i in (1, 3, 5)]
    cb = [int(b[i : i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * amount):02x}" for x, y in zip(ca, cb))


def cell_width(ch):
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def text_width(text):
    return sum(cell_width(c) for c in text)


class Screen:
    """A cell buffer that only redraws what changed since the last frame."""

    def __init__(self, width, height):
        self.resize(width, height)

    def resize(self, width, height):
        self.w, self.h = width, height
        self.prev = None
        self.clear()

    def clear(self):
        n = self.w * self.h
        self.ch = [" "] * n
        self.fg = [BLACK] * n
        self.bg = [BLACK] * n

    def put(self, x, y, text, fg, bg=BLACK):
        """Write text at x, y. Wide (CJK) characters take two cells, the
        second holding an empty string."""
        if not 0 <= y < self.h:
            return x
        for c in text:
            cw = cell_width(c)
            if x >= 0 and x + cw <= self.w:
                i = y * self.w + x
                # Don't leave half of a wide character behind
                if self.ch[i] == "" and x > 0:
                    self.ch[i - 1] = " "
                end = i + cw
                if x + cw < self.w and self.ch[end] == "":
                    self.ch[end] = " "
                self.ch[i], self.fg[i], self.bg[i] = c, fg, bg
                if cw == 2:
                    self.ch[i + 1], self.fg[i + 1], self.bg[i + 1] = "", fg, bg
            x += cw
        return x

    def fill_row(self, y, bg=BLACK):
        self.put(0, y, " " * self.w, BLACK, bg)

    def center(self, y, text, fg, bg=BLACK):
        self.put((self.w - text_width(text)) // 2, y, text, fg, bg)

    def box(self, x, y, w, h, color, fill=BLACK):
        """A double-line box. Only the inside gets the fill color, since a
        border cell's background shows around the line."""
        self.put(x, y, "╔" + "═" * (w - 2) + "╗", color)
        for row in range(y + 1, y + h - 1):
            self.put(x, row, "║", color)
            self.put(x + 1, row, " " * (w - 2), color, fill)
            self.put(x + w - 1, row, "║", color)
        self.put(x, y + h - 1, "╚" + "═" * (w - 2) + "╝", color)

    def flush(self, out):
        parts = []
        cur_fg = cur_bg = None
        next_i = -1
        prev = self.prev
        for i, c in enumerate(self.ch):
            if c == "":
                continue
            if prev and c == prev[0][i] and self.fg[i] == prev[1][i] and self.bg[i] == prev[2][i]:
                continue
            if i != next_i or i % self.w == 0:
                parts.append(f"\x1b[{i // self.w + 1};{i % self.w + 1}H")
            if self.fg[i] != cur_fg:
                cur_fg = self.fg[i]
                parts.append("\x1b[38;2;%d;%d;%dm" % tuple(int(cur_fg[j : j + 2], 16) for j in (1, 3, 5)))
            if self.bg[i] != cur_bg:
                cur_bg = self.bg[i]
                parts.append("\x1b[48;2;%d;%d;%dm" % tuple(int(cur_bg[j : j + 2], 16) for j in (1, 3, 5)))
            parts.append(c)
            next_i = i + cell_width(c)
        self.prev = (self.ch[:], self.fg[:], self.bg[:])
        if parts:
            out.write("".join(parts))
            out.flush()


def read_first(path, default=""):
    try:
        return pathlib.Path(path).read_text().split("\n")[0].strip()
    except OSError:
        return default


def system_stats():
    """A rotating set of real stats for the MAGI log."""
    stats = []
    load = read_first("/proc/loadavg").split()
    if load:
        stats.append(f"MAGI LOAD {load[0]} / {load[1]} / {load[2]}")
    meminfo = {}
    try:
        for line in pathlib.Path("/proc/meminfo").read_text().splitlines():
            key, _, value = line.partition(":")
            meminfo[key] = int(value.split()[0])
        used = (meminfo["MemTotal"] - meminfo["MemAvailable"]) / 1048576
        stats.append(f"MEMORY {used:.1f} / {meminfo['MemTotal'] / 1048576:.1f} GB")
    except (OSError, KeyError, ValueError):
        pass
    for bat in sorted(pathlib.Path("/sys/class/power_supply").glob("BAT*")):
        capacity = read_first(bat / "capacity")
        status = read_first(bat / "status").upper()
        if capacity:
            stats.append(f"POWER {capacity}% · {status}")
        break
    temp = read_first("/sys/class/thermal/thermal_zone0/temp")
    if temp.isdigit():
        stats.append(f"CORE TEMP {int(temp) / 1000:.0f}°C")
    uptime = read_first("/proc/uptime").split()
    if uptime:
        seconds = int(float(uptime[0]))
        days, rem = divmod(seconds, 86400)
        stats.append(f"UPTIME {days}d {rem // 3600}h {rem % 3600 // 60}m")
    return stats


class Magi:
    """The MAGI deliberating one proposal after another."""

    UNITS = ["BALTHASAR·2", "CASPER·3", "MELCHIOR·1"]

    def __init__(self, now):
        self.number = random.randint(100, 900)
        self.start(now)

    def start(self, now):
        self.number += 1
        self.topic = random.choice(TOPICS)
        self.started = now
        forced = self.topic[2]
        self.votes = [
            (now + random.uniform(2, 7), False if forced == "reject" else random.random() < 0.8)
            for _ in self.UNITS
        ]
        self.decided_at = max(t for t, _ in self.votes)

    def update(self, now):
        if now > self.decided_at + 6:
            self.start(now)

    def state(self, unit, now):
        """None while deliberating, else True for approve and False for reject."""
        done_at, vote = self.votes[unit]
        return vote if now >= done_at else None

    def verdict(self, now):
        if now < self.decided_at:
            return None
        approvals = sum(vote for _, vote in self.votes)
        if approvals == 3:
            return "全会一致 承認 · UNANIMOUS APPROVAL", True
        if approvals == 2:
            return "多数決 承認 2:1 · APPROVED BY MAJORITY", True
        return "否決 · PROPOSAL REJECTED", False


class Saver:
    def __init__(self, screen, colors, alert):
        self.s = screen
        self.c = colors
        self.hex = mix(colors["muted"], BLACK, 0.55)
        self.hex_lit = mix(colors["accent"], BLACK, 0.5)
        self.rule = mix(colors["accent"], BLACK, 0.4)
        now = time.monotonic()
        self.magi = Magi(now)
        self.sync = [0.41] * 200
        self.next_sync = now
        self.log = []
        self.next_log = now
        self.stats = []
        self.alert_until = now + 12 if alert else 0
        self.next_alert = now + random.uniform(150, 360)
        self.host = os.environ.get("MAGI_HOST", socket.gethostname()).upper()

    def blink(self, now, period=0.5):
        return int(now / period) % 2 == 0

    def draw_hex(self, now, color, lit):
        """A hex grid backdrop with a slow sweep running down it."""
        tiles = ("__/  \\", "  \\__/")
        sweep = (now * 3) % (self.s.h + 12) - 6
        for y in range(self.s.h):
            tile = tiles[y % 2]
            row = (tile * (self.s.w // 6 + 2))[: self.s.w]
            self.s.put(0, y, row, lit if abs(y - sweep) < 1.5 else color)

    def draw_header(self, now):
        s, c = self.s, self.c
        s.fill_row(0)
        x = s.put(1, 0, "▌NERV ", c["accent"])
        x = s.put(x, 0, "特務機関ネルフ", c["foreground"])
        if s.w >= 70:
            s.put(x + 2, 0, "· MAGI SYSTEM", c["dark_foreground"])
        clock = time.strftime("%Y.%m.%d %a %H:%M:%S").upper()
        s.put(s.w - len(clock) - 1, 0, clock, c["foreground"])
        s.put(0, 1, "━" * s.w, self.rule)

    def draw_magi(self, now, top, bottom):
        """The three MAGI boxes between rows top and bottom (exclusive)."""
        s, c, magi = self.s, self.c, self.magi
        space = bottom - top
        bh = 7 if space >= 20 else 5
        bw = max(20, min(34, s.w // 4))
        cx = s.w // 2

        s.fill_row(top)
        jp, en, _ = magi.topic
        s.center(top, f"提訴 #{magi.number:04d} · {jp} · {en}", c["foreground"])

        ty = top + 2
        sy = ty + bh + 1
        gap = max(7, bw // 3)
        boxes = [(cx - bw // 2, ty), (cx - gap - bw, sy), (cx + gap, sy)]

        # Wiring to the MAGI label in the middle
        my = sy + bh // 2
        for y in range(ty + bh, my):
            s.put(cx, y, "┃", c["accent"])
        s.put(cx - gap, my, "━" * (gap - 3), c["accent"])
        s.put(cx + 4, my, "━" * (gap - 4), c["accent"])
        s.put(cx - 2, my, "MAGI", c["accent"])

        for unit, (x, y) in enumerate(boxes):
            state = magi.state(unit, now)
            if state is None:
                color = c["yellow"] if self.blink(now) else c["dark_foreground"]
                label, fill = "審議中", BLACK
            else:
                color = c["green"] if state else c["red"]
                label, fill = ("承認" if state else "否決"), mix(color, BLACK, 0.88)
            s.box(x, y, bw, bh, color, fill)
            name = magi.UNITS[unit]
            s.put(x + (bw - text_width(name)) // 2, y + 1, name, color, fill)
            s.put(x + (bw - text_width(label)) // 2, y + bh // 2 + 1, label, color, fill)

        result_y = sy + bh
        s.fill_row(result_y)
        verdict = magi.verdict(now)
        if verdict:
            text, passed = verdict
            s.center(result_y, f"決議: {text}", c["green"] if passed else c["red"])
        else:
            s.center(result_y, "審議中 · DELIBERATING", c["dark_foreground"])

    def draw_panels(self, now, top, bottom):
        s, c = self.s, self.c
        height = bottom - top
        if height < 2:
            return
        for y in range(top, bottom):
            s.fill_row(y)
        half = s.w // 2

        # Unit-01 sync rate, scrolling right to left
        rate = self.sync[-1]
        s.put(1, top, "SYNC RATE · UNIT-01", c["dark_foreground"])
        s.put(half - 8, top, f"{rate * 100:5.1f}%", c["green"])
        rows = height - 1
        levels = " ▁▂▃▄▅▆▇█"
        graph_w = half - 2
        fill = mix(c["green"], BLACK, 0.8)
        for i, value in enumerate(self.sync[-graph_w:]):
            # Scale 30-50% onto the graph's height, in eighths of a row
            eighths = max(0, min(rows * 8, round((value - 0.30) / 0.20 * rows * 8)))
            # A dim fill under a bright top edge, so it reads as a trace
            for row in range(rows):
                part = max(0, min(8, eighths - row * 8))
                top_edge = eighths - row * 8 <= 8
                s.put(1 + i, bottom - 1 - row, levels[part], c["green"] if top_edge else fill)

        # MAGI log, newest line brightest
        s.put(half + 1, top, "MAGI LOG", c["dark_foreground"])
        lines = self.log[-(height - 1) :]
        for i, line in enumerate(lines):
            fade = (len(lines) - 1 - i) / max(1, height - 1)
            color = mix(c["foreground"], BLACK, 0.2 + fade * 0.55)
            s.put(half + 1, top + 1 + i, ("> " + line)[: s.w - half - 2], color)

    def draw_footer(self, now):
        s, c = self.s, self.c
        y = s.h - 1
        s.fill_row(y)
        s.put(1, y, "SELF-DESTRUCT: DISABLED", c["dark_foreground"])
        status = "STANDBY"
        s.put(s.w - len(status) - 1, y, status, c["accent"] if self.blink(now, 1.0) else c["dark_foreground"])
        if s.w >= 70:
            s.center(y, f"TERMINAL DOGMA · {self.host}", c["dark_foreground"])

    def draw_alert(self, now):
        s, c = self.s, self.c
        red = c["red"]
        self.draw_hex(now, mix(red, BLACK, 0.8), mix(red, BLACK, 0.5))

        # Diagonal hazard stripes moving along the top and bottom edges. Each
        # stripe is ▟██▛ in the accent color, shifted a cell per row so the
        # half-cell steps line up into slanted edges
        offset = int(now * 8)
        pattern = "▟██▛  "
        bands = [(0, 1), (s.h - 2, s.h - 1)] if s.h >= 20 else [(0,), (s.h - 1,)]
        for band in bands:
            for level, y in enumerate(reversed(band)):
                for x in range(s.w):
                    s.put(x, y, pattern[(x - level - offset) % len(pattern)], c["accent"])

        word = "EMERGENCY"
        banner_w = len(word) * 6 - 1
        by = s.h // 2 - 4
        frame = red if self.blink(now) else mix(red, BLACK, 0.6)
        if s.w >= banner_w + 6:
            s.box((s.w - banner_w) // 2 - 3, by - 1, banner_w + 6, 7, frame)
            x0 = (s.w - banner_w) // 2
            for i, letter in enumerate(word):
                for row, bits in enumerate(BLOCK_FONT[letter]):
                    s.put(x0 + i * 6, by + row, bits, red)
        else:
            s.box((s.w - 16) // 2, by + 1, 16, 3, frame)
            s.center(by + 2, word, red)

        s.put((s.w - banner_w) // 2 - 3, by - 2, " 警告 WARNING ", c["accent"])
        s.center(by + 7, " 緊急事態発生 ", red)
        if self.blink(now, 0.8):
            s.center(by + 8, " PATTERN BLUE · 使徒 確認 · ANGEL CONFIRMED ", c["foreground"])
        else:
            s.fill_row(by + 8)

    def update(self, now):
        self.magi.update(now)
        while now >= self.next_sync:
            last = self.sync[-1]
            self.sync.append(max(0.31, min(0.49, last + random.gauss(0, 0.012) + (0.41 - last) * 0.05)))
            self.sync = self.sync[-400:]
            self.next_sync += 0.3
        if now >= self.next_log:
            if not self.stats:
                self.stats = system_stats()
                random.shuffle(self.stats)
            line = self.stats.pop() if random.random() < 0.6 and self.stats else random.choice(FLAVOR)
            self.log = (self.log + [line])[-40:]
            self.next_log = now + random.uniform(1.5, 3)
        if not self.alert_until and now >= self.next_alert:
            self.alert_until = now + 12
            self.log.append("!! PATTERN BLUE DETECTED !!")
        if self.alert_until and now >= self.alert_until:
            self.alert_until = 0
            self.next_alert = now + random.uniform(150, 360)
            self.log.append("TARGET LOST · RETURNING TO STANDBY")

    def draw(self, now):
        s = self.s
        s.clear()
        if self.alert_until:
            self.draw_alert(now)
            return
        self.draw_hex(now, self.hex, self.hex_lit)
        self.draw_header(now)
        bh = 7 if s.h >= 34 else 5
        magi_rows = 2 * bh + 4
        panel_rows = max(0, s.h - 2 - magi_rows - 2)
        self.draw_magi(now, 2, 2 + magi_rows)
        if panel_rows:
            s.put(0, 2 + magi_rows, "─" * s.w, self.rule)
            self.draw_panels(now, 3 + magi_rows, s.h - 1)
        self.draw_footer(now)


def in_screensaver_window():
    """Omarchy's launcher runs us in a terminal with the screensaver class."""
    try:
        return SCREENSAVER_CLASS in pathlib.Path(f"/proc/{os.getppid()}/cmdline").read_text()
    except OSError:
        return False


def screensaver_in_focus():
    result = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True)
    return f'"class": "{SCREENSAVER_CLASS}"' in result.stdout


def set_cursor_invisible(invisible):
    value = "true" if invisible else "false"
    if subprocess.run(["hyprctl", "eval", f"hl.config({{ cursor = {{ invisible = {value} }} }})"], capture_output=True).returncode:
        subprocess.run(["hyprctl", "keyword", "cursor:invisible", value], capture_output=True)


def terminal_size():
    size = os.get_terminal_size()
    return size.columns, size.lines


def main():
    screensaver = in_screensaver_window()
    alert = "--alert" in sys.argv[1:]

    # Terminals start at 80x24 and resize once the compositor sizes the
    # window, so wait for that before laying anything out
    deadline = time.monotonic() + 2
    while terminal_size() == (80, 24) and time.monotonic() < deadline:
        time.sleep(0.02)

    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(True))
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))

    out = sys.stdout
    fd = sys.stdin.fileno()
    saved_tty = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    out.write("\x1b[?1049h\x1b[?25l\x1b]11;rgb:00/00/00\x07\x1b[2J")
    if screensaver:
        set_cursor_invisible(True)

    screen = Screen(*terminal_size())
    saver = Saver(screen, load_colors(), alert)
    started = time.monotonic()
    next_focus_check = started + 2

    try:
        while True:
            frame_start = time.monotonic()
            if resized:
                resized.clear()
                screen.resize(*terminal_size())
                out.write("\x1b[2J")
            saver.update(frame_start)
            saver.draw(frame_start)
            screen.flush(out)

            if screensaver and frame_start >= next_focus_check:
                if not screensaver_in_focus():
                    break
                next_focus_check = frame_start + 1

            timeout = max(0, 1 / FPS - (time.monotonic() - frame_start))
            if select.select([fd], [], [], timeout)[0]:
                os.read(fd, 1024)
                break
    except KeyboardInterrupt:
        pass
    except OSError:
        pass  # The terminal went away, e.g. closed along with another monitor's
    finally:
        # Restore the mouse cursor first: when the window is closed from
        # outside, the terminal is already gone and resetting it fails
        if screensaver:
            set_cursor_invisible(False)
        try:
            out.write("\x1b[0m\x1b[?25h\x1b[?1049l")
            out.flush()
            termios.tcsetattr(fd, termios.TCSADRAIN, saved_tty)
        except OSError:
            pass
        if screensaver:
            # Close the screensaver on every monitor, as Omarchy's does
            subprocess.run(["pkill", "-f", f"[{SCREENSAVER_CLASS[0]}]{SCREENSAVER_CLASS[1:]}"])


if __name__ == "__main__":
    main()
